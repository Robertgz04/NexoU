# Configuración del backend dentro de la red Docker del servidor.
# No incluir este archivo ni credenciales SQL en la app móvil.
# Fuera de Docker, nexou-db no resuelve. Para desarrollo con SQL local,
# cambiar DB_HOST/DB_PORT y usar credenciales de esa instancia.
DB_HOST=nexou-db
DB_PORT=3306
DB_NAME=nexou
DB_USER=nexou_runtime
DB_PASSWORD="CAMBIA_ESTA_CLAVE"

# Solo servidor; no importar en Metro/React Native.
API_PORT=3000
API_HOST=0.0.0.0
APP_TIME_ZONE=America/Mexico_City
UPLOAD_DIR=/uploads
MAX_PHOTO_BYTES=5242880
SESSION_DAYS=7
DB_POOL_SIZE=10
PUSH_ENABLED=false
# GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/privada/firebase-admin.json
# Direcciones IP del proxy confiable, separadas por comas; vacío sin proxy.
TRUST_PROXY=172.30.80.1
NODE_ENV=production
